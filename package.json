{
  "name": "our-private-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/app-regression.cjs",
    "audit:storage": "node --env-file=.env.local scripts/audit-storage-recovery.mjs"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "7.3.5",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.4",
    "playwright": "^1.62.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.14.4",
  "pnpm": {
    "overrides": {
      "yaml-language-server>yaml": "2.9.0"
    }
  }
}
