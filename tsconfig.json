{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "strictNullChecks": true, "allowJs": false, "skipLibCheck": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "node_modules"]
}
